{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"]
  },

  "include": [
    "**/*.ts"
  ]
}